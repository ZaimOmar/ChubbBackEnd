# DEV-ONLY CONFIGURATION. Every value below is a throwaway local credential, NOT for production.
# Compose only interpolates from .env (git-ignored); docker-compose.yml carries the same dev-only
# defaults, so a clean clone needs no .env. To override, copy this file to .env and edit.
# Each service receives only the keys it needs (no shared env_file).
#
# Names use the ASP.NET Core "__" form (Section__Key) so they bind straight into configuration.

# --- Environment ---
# Development enables auto-migration, seeding and the aggregated OpenAPI/Swagger (Identity/Gateway spec).
ASPNETCORE_ENVIRONMENT=Development

# --- Postgres: one instance, one database and one login role per service ---
# Superuser, used only by the postgres container itself and its init script.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-postgres-admin
# Per-service role passwords (created by docker/postgres/init-databases.sh on first start).
# Keep each in step with the matching connection string below.
IDENTITY_DB_PASSWORD=dev-only-identity-db
CLAIMS_DB_PASSWORD=dev-only-claims-db
REPORTING_DB_PASSWORD=dev-only-reporting-db
NOTIFICATION_DB_PASSWORD=dev-only-notification-db

# --- Identity ---
# Scanner note: the "Password=" below trips generic secret rules. docker-compose.yml builds the
# container's connection string from IDENTITY_DB_PASSWORD instead, so this line is only a
# reference for running Identity outside compose. If gitleaks flags it, add a path allowlist for
# .env.example (dev-only values) to a .gitleaks.toml rather than weakening the rules.
ConnectionStrings__IdentityDb=Host=postgres;Port=5432;Database=identity_db;Username=identity;Password=dev-only-identity-db
# Shared password of all seeded users (claimant@chubb.test, officer@chubb.test, ...). See README.
Identity__SeedPassword=Dev-Only-Passw0rd!

# --- JWT (ADR-008). Keys come from the jwt-keys init container (or scripts/dev-keys.sh) ---
Jwt__Issuer=chubb-identity
Jwt__Audience=chubb-claims-api
Jwt__LifetimeMinutes=30
# Container paths of the key volumes. Private key is mounted into Identity only.
Jwt__PrivateKeyPath=/run/jwt-private/private.pem
Jwt__PublicKeyPath=/run/jwt-public/public.pem

# --- Gateway ---
# Host port published for the gateway (bound to 127.0.0.1 only).
GATEWAY_HOST_PORT=8080
Cors__AllowedOrigins__0=http://localhost:4200
OpenApi__ContractsPath=/app/contracts/openapi
# Cluster destinations (cluster ids identity/claims/reporting/notification must match the Gateway config).
ReverseProxy__Clusters__identity__Destinations__primary__Address=http://identity:8080/
ReverseProxy__Clusters__claims__Destinations__primary__Address=http://claims:8080/
ReverseProxy__Clusters__reporting__Destinations__primary__Address=http://reporting:8080/
ReverseProxy__Clusters__notification__Destinations__primary__Address=http://notification:8080/
