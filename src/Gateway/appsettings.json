{
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "chubb-identity",
    "Audience": "chubb-claims-api"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-token": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/auth/token", "Methods": [ "POST" ] }
      },
      "claims": {
        "ClusterId": "claims",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/claims/{**remainder}" }
      },
      "dashboard": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/dashboard/{**remainder}" }
      },
      "staff": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/staff/{**remainder}" }
      },
      "notifications": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/notifications/{**remainder}" }
      }
    },
    "Clusters": {
      "identity": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "primary": { "Address": "http://localhost:5001" } }
      },
      "claims": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "primary": { "Address": "http://localhost:5002" } }
      },
      "reporting": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "primary": { "Address": "http://localhost:5003" } }
      },
      "notification": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "primary": { "Address": "http://localhost:5004" } }
      }
    }
  }
}
